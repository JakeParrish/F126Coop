# Postgres connection string (Railway provides this automatically as DATABASE_URL)
DATABASE_URL="postgresql://user:password@localhost:5432/f1coopsim?schema=public"

# Port the server listens on (Railway sets PORT automatically)
PORT=3000

# Optional: comma-separated allowed origins for CORS in development
CORS_ORIGINS="http://localhost:5173"

# --- Discord auth (optional; login is disabled until set) ---
# Create an app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Must exactly match a redirect added in the Discord app's OAuth2 settings:
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"
# Secret used to sign session cookies (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-string"
# Comma-separated Discord user IDs that bypass the 1-driver claim limit
ADMIN_DISCORD_IDS=""
